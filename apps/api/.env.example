DATABASE_URL="postgresql://homeinterior:homeinterior@localhost:5432/homeinterior?schema=public"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_TTL="30d"

PORT=3001
WEB_ORIGIN="http://localhost:3000"
PUBLIC_API_URL="http://localhost:3001"

STORAGE_ROOT="../../storage"
UPLOAD_SIGNING_SECRET="dev-upload-signing-secret-change-me"

CHROME_EXECUTABLE_PATH="/usr/bin/google-chrome"

# Optional. Leave unset to use the free, deterministic StubAiProvider (no
# API calls, no cost). Set this to switch every AI feature to real Claude
# calls with no other code change — see src/ai/providers/ai-provider.factory.ts.
# ANTHROPIC_API_KEY=""

# Optional. Leave unset and the Billing endpoints report "not configured"
# (see BillingService) instead of crashing. Get free TEST-mode keys from
# https://dashboard.stripe.com/test/apikeys — no real charges ever happen
# with test keys. STRIPE_PRO_PRICE_ID / STRIPE_ULTIMATE_PRICE_ID are
# test-mode recurring Price ids (dashboard.stripe.com/test/products) — one
# per paid tier. For webhooks in local dev, run
# `stripe listen --forward-to localhost:3001/billing/webhook` and use the
# signing secret it prints.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PRO_PRICE_ID="price_..."
# STRIPE_ULTIMATE_PRICE_ID="price_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
